# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit real keys.

# --- Required: API key for an OpenAI-compatible endpoint ------------------
OPENAI_API_KEY=sk-your-key-here

# --- Optional: use a compatible proxy/gateway instead of api.openai.com ---
# Leave blank/unset for the official OpenAI API. Set it to use LiteLLM,
# Azure OpenAI, a local vLLM/Ollama server, etc.
# OPENAI_BASE_URL=https://your-proxy.example.com

# Set to false ONLY if your proxy uses a self-signed certificate.
# OPENAI_VERIFY_SSL=true

# --- Optional: override the model used for each role (defaults shown) -----
# MODEL_PARSE=gpt-4o-mini
# MODEL_CLASSIFY=gpt-4o-mini
# MODEL_MATCH=gpt-4o
# MODEL_AGENT=gpt-4o
# MODEL_GENERATE=gpt-4o
# EMBED_MODEL=text-embedding-3-large

# --- Optional: database (defaults to a local SQLite file) ----------------
# DATABASE_URL=sqlite:///./recruitment.db
